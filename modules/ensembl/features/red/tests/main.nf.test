nextflow_process {

    name "Test Process FEATURES_RED"
    script "../main.nf"
    process "FEATURES_RED"

    tag "modules"
    tag "modules_local"
    tag "features"
    tag "features/red"
    topics "versions"

    test("Stub creates Red repeat report") {

        when {
            options "-stub"

            process {
                """
                def fasta = file("test.fa")
                fasta.text = ">test\\nACGT\\n"

                input[0] = record(meta: [ id:'test' ], fasta: fasta)
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
            assert process.out[0].size() == 1
            assert process.out[0][0].meta == [ id: 'test' ]
            assert file(process.out[0][0].bed).name == "test.bed"
            assert file(process.out[0][0].bed).size() > 0
            assert topics.versions.size() == 1
            assert topics.versions[0].size() == 2
            assert topics.versions[0][0] == 'red'
        }
    }
}
